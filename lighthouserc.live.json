{
  "ci": {
    "collect": {
      "url": ["https://pequeverso.com/", "https://pequeverso.com/grafismo-fonetico/"],
      "numberOfRuns": 5,
      "settings": {
        "preset": "desktop",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "blockedUrlPatterns": ["*://connect.facebook.net/*", "*://*.facebook.com/*"]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-live"
    }
  }
}
