{
  "ci": {
    "collect": {
      "startServerCommand": "node tools/serve-static.ts",
      "startServerReadyPattern": "serve-static: http",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/grafismo-fonetico/",
        "http://localhost:3000/imprime-y-juega/",
        "http://localhost:3000/grafismo-fonetico/gracias/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "blockedUrlPatterns": ["*://www.facebook.com/tr*"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "uses-responsive-images": "off",
            "unused-javascript": "off",
            "csp-xss": "off"
          }
        }
      ],
      "_note": "Performance, best-practices, SEO, LCP, TBT, CLS and script KB are asserted by tools/lhci-assert.ts against ratchets/lighthouse-lab.json (M2-1), not here, so the thresholds live in one file."
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
