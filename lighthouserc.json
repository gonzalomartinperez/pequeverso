{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-static.mjs",
      "startServerReadyPattern": "serve-static: http",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/grafismo-fonetico/",
        "http://localhost:3000/imprime-y-juega/",
        "http://localhost:3000/grafismo-fonetico/gracias/"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        },
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "warn",
              {
                "maxNumericValue": 200
              }
            ],
            "uses-responsive-images": "off",
            "unused-javascript": "off",
            "csp-xss": "off"
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/(grafismo-fonetico/)?$",
          "assertions": {
            "categories:seo": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "resource-summary:script:size": [
              "warn",
              {
                "maxNumericValue": 230000
              }
            ],
            "resource-summary:image:size": [
              "warn",
              {
                "maxNumericValue": 1100000
              }
            ],
            "resource-summary:total:size": [
              "warn",
              {
                "maxNumericValue": 1500000
              }
            ]
          },
          "_note": "Byte budgets apply to pages we fully control; /imprime-y-juega/ also loads the Hotmart widget bundle (~1 MB, third party)."
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
