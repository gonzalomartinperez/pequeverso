{
  "ci": {
    "collect": {
      "startServerCommand": "node tools/serve-static.ts",
      "startServerReadyPattern": "serve-static: http",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/grafismo-fonetico/",
        "http://localhost:3000/imprime-y-juega/",
        "http://localhost:3000/grafismo-fonetico/gracias/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "blockedUrlPatterns": ["*://*.facebook.com/*"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "uses-responsive-images": "off",
            "unused-javascript": "off",
            "csp-xss": "off",
            "categories:best-practices": [
              "warn",
              {
                "minScore": 0.9
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:3000/(grafismo-fonetico/)?$",
          "assertions": {
            "categories:seo": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "resource-summary:image:size": [
              "warn",
              {
                "maxNumericValue": 1100000
              }
            ],
            "resource-summary:total:size": [
              "warn",
              {
                "maxNumericValue": 1500000
              }
            ]
          }
        }
      ],
      "_note": "Performance, LCP, TBT, CLS and first-party script KB are asserted at error level by tools/lhci-assert.ts against ratchets/lighthouse-lab.json (M2-1), so those thresholds live in one file. Accessibility is an error here; best-practices, SEO and the image and total byte budgets stay at warn."
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
