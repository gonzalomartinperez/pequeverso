{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,error,global-error,not-found}.tsx!",
    "src/app/**/{sitemap,robots}.ts!",
    "src/shared/ui/*.{ts,tsx}!",
    "tools/*.ts",
    "tools/lib/*.ts",
    "tests/unit/**/*.test.ts",
    "tests/browser/**/*.spec.ts",
    "src/app/**/route.standalone.ts!",
    "config/next.ts!",
    "config/cn.ts!",
    "src/shared/{editorial,identity,media,navigation}/*.{ts,tsx}!",
    "src/shared/motion/**/*.{ts,tsx}!",
    "src/shell/*.{ts,tsx}!",
    "src/views/**/*.{ts,tsx}!"
  ],
  "project": ["src/**!", "config/**!", "content/**!", "tools/**", "tests/**"],
  "ignoreExportsUsedInFile": true,
  "tags": ["-internal"],
  "ignoreBinaries": ["openssl"]
}
