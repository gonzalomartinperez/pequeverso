{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,error,global-error,not-found}.tsx!",
    "src/app/**/{sitemap,robots}.ts!",
    "src/components/ui/*.{ts,tsx}!",
    "src/components/blocks/*.tsx!",
    "src/motion/*.{ts,tsx}!",
    "src/motion/scene/*.{ts,tsx}!",
    "scripts/*.mjs",
    "scripts/lib/*.mjs",
    "tests/unit/**/*.test.mjs",
    "tests/e2e/**/*.spec.ts",
    "src/app/**/route.standalone.ts!"
  ],
  "project": [
    "src/**!",
    "config/**!",
    "content/**!",
    "scripts/**",
    "server/**",
    "!server/*.d.mts",
    "tests/**"
  ],
  "ignoreExportsUsedInFile": true,
  "tags": ["-internal"]
}
