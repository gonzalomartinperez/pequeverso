{
  "name": "pequeverso",
  "version": "0.2.0",
  "private": true,
  "description": "Pequeverso commercial website: static Next.js landings for the Grafismo Fonético printable kit, with Hotmart checkout.",
  "homepage": "https://pequeverso.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/gonzalomartinperez/pequeverso.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=10.9 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-env.mjs && node scripts/build-info.mjs && next build --webpack && node scripts/gen-htaccess.mjs",
    "build:standalone": "cross-env NEXT_OUTPUT=standalone npm run build",
    "start": "node scripts/start.mjs",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node --env-file-if-exists=.env.example --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "cross-env PW_SET=pr playwright test",
    "test:e2e:nightly": "cross-env PW_SET=nightly playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run knip:production && npm run build && npm run check:media && npm run check:placeholders && npm run check:bundle && npm run check:rendered",
    "check:env": "node scripts/check-env.mjs",
    "check:media": "node scripts/check-media-budget.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:placeholders:strict": "node scripts/check-placeholders.mjs --strict",
    "lhci": "lhci autorun",
    "smoke": "node scripts/smoke.mjs",
    "start:static": "node scripts/serve-static.mjs",
    "test:e2e:visual": "cross-env PW_SET=visual playwright test",
    "test:e2e:prod": "cross-env PW_SET=prod playwright test",
    "knip": "knip --no-progress",
    "knip:production": "knip --no-progress --production",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "analyze": "cross-env ANALYZE=1 next build --webpack",
    "check:rendered": "node scripts/check-rendered.mjs"
  },
  "dependencies": {
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.13",
    "@lhci/cli": "0.15.1",
    "@next/bundle-analyzer": "16.3.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "knip": "6.35.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
