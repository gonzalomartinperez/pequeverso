{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "plugins": [],
    "incremental": false
  },
  "include": [
    "tools/**/*.ts",
    "src/features/tracking/adapters/server/**/*.ts",
    "tests/unit/**/*.ts",
    "config/next.ts"
  ],
  "exclude": ["node_modules", "tools/media"]
}
