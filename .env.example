# Copy to .env.local before building: `cp .env.example .env.local`. The repository ships no
# inline deployment values; scripts/check-env.ts refuses to build without the required ones.
# Optional integrations degrade to documented no-ops when their variable is empty.

# Required. Canonical origin for metadata, canonicals, sitemap and OG URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://pequeverso.com

# Required. Hotmart checkout URL of the principal product (https://pay.hotmart.com/<offer>?checkoutMode=10).
# The legacy name NEXT_PUBLIC_CHECKOUT_URL is still honoured as a fallback.
NEXT_PUBLIC_CHECKOUT_URL_GRAFISMO_FONETICO=https://pay.hotmart.com/TEST0000000?checkoutMode=10

# Meta Pixel ID (15-16 digits). Empty = no pixel and no cookie banner. When set, the pixel runs
# by default and the banner lets visitors reject it (choice kept for six months).
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token (server-only: read by the Node server at runtime, never
# inlined in the browser bundle). Set it in hPanel → Environment variables, never in the repo.
# Empty = the /api/meta/events/ relay answers 204 and Meta is never called from the server.
META_CAPI_ACCESS_TOKEN=

# Build mode: "export" (default, static files) or "standalone" (Node server).
NEXT_OUTPUT=export

# Set by CI for build-info.json; optional locally.
GITHUB_SHA=
GITHUB_REF_NAME=
