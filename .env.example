# Copy to .env.local for local overrides. Every value is optional: with the
# defaults below the site builds and runs from a fresh clone, and integrations
# degrade to documented no-ops.

# Canonical origin used for metadata, canonicals, sitemap and OG URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://pequeverso.com

# Hotmart checkout override for the principal product. The public checkout URL is the default in
# src/products/grafismo-fonetico.ts; set NEXT_PUBLIC_CHECKOUT_URL_GRAFISMO_FONETICO (or the legacy
# NEXT_PUBLIC_CHECKOUT_URL) only to point at a different offer.
NEXT_PUBLIC_CHECKOUT_URL_GRAFISMO_FONETICO=

# Meta Pixel ID (15-16 digits). Empty = no pixel and no cookie banner. When set, the pixel runs
# by default and the banner lets visitors reject it (choice kept for six months).
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token (server-only: read by the Node server at runtime, never
# inlined in the browser bundle). Set it in hPanel → Environment variables, never in the repo.
# Empty = the /api/meta/events/ relay answers 204 and Meta is never called from the server.
META_CAPI_ACCESS_TOKEN=

# Build mode: "export" (default, static files) or "standalone" (Node server).
NEXT_OUTPUT=export

# Set by CI for build-info.json; optional locally.
GITHUB_SHA=
GITHUB_REF_NAME=
