# Copy to .env.local for local overrides. Every value is optional: with the
# defaults below the site builds and runs from a fresh clone, and integrations
# degrade to documented no-ops.

# Canonical origin used for metadata, canonicals, sitemap and OG URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://pequeverso.com

# Hotmart checkout for the principal product. The public value is documented in
# docs/content-model.md; leave empty to render CTAs that point to the landing itself.
NEXT_PUBLIC_CHECKOUT_URL=https://pay.hotmart.com/D106959604R?checkoutMode=10

# Meta Pixel ID. Empty = tracking module is a no-op (no script is ever injected).
NEXT_PUBLIC_META_PIXEL_ID=

# Optional cookie-less analytics (Umami). Both empty = disabled.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Print every tracking event to the console (development aid).
NEXT_PUBLIC_TRACKING_DEBUG=

# Build mode: "export" (default, static files) or "standalone" (Node server).
NEXT_OUTPUT=export

# Set by CI for build-info.json; optional locally.
GITHUB_SHA=
GITHUB_REF_NAME=
